// Para activarla: node scripts/use-postgres.mjs
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Nutritionist {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  license            String?
  phone              String?
  clinicName         String?
  address            String?
  title              String?
  area               String?
  manager            String?
  role               String   @default("nutritionist") // nutritionist | chief | technical
  technical          Boolean  @default(false)
  mustChangePassword Boolean  @default(false)
  avatarBytes        Bytes?
  avatarMime         String?
  avatarAt           DateTime?
  createdAt          DateTime @default(now())

  patients              Patient[]
  appointments          Appointment[]
  notifications         Notification[]
  activityLogs          ActivityLog[]        @relation("ActivityActor")
  referralsAssigned     Referral[]           @relation("ReferralAssignedTo")
  referralsCreated      Referral[]           @relation("ReferralAssignedBy")
}

model Patient {
  id             String   @id @default(cuid())
  nutritionistId String?
  nutritionist   Nutritionist? @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  fullName       String
  dni            String?
  sex            String
  birthDate      String?
  phone          String?
  email          String?
  occupation     String?
  diagnosis      String?
  diagnosisCodes String?
  diabetesType   String   @default("ninguna")
  heightCm       Float?
  createdAt      DateTime @default(now())

  anamneses    Anamnesis[]
  isak         IsakAssessment[]
  omron        OmronReading[]
  glucose      GlucoseReading[]
  meals        MealEntry[]
  labs         LabResult[]
  plans        MealPlan[]
  notes        ProgressNote[]
  appointments Appointment[]
  referrals    Referral[]

  @@index([nutritionistId])
}

model Anamnesis {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payload   String
  createdAt DateTime @default(now())
}

model IsakAssessment {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  measuredAt DateTime
  payload    String
  createdAt  DateTime @default(now())
}

model OmronReading {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  measuredAt DateTime
  payload    String
  createdAt  DateTime @default(now())
}

model GlucoseReading {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  value      Float
  slot       String   @default("ayunas")
  measuredAt DateTime @default(now())
}

model MealEntry {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  type      String
  carbs     Float    @default(0)
  protein   Float?
  fat       Float?
  sugar     Float?
  calories  Float?
  createdAt DateTime @default(now())
}

model LabResult {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  glucose       Float?
  hba1c         Float?
  creatinine    Float?
  ldl           Float?
  triglycerides Float?
  measuredAt    DateTime @default(now())
}

model MealPlan {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payload   String
  createdAt DateTime @default(now())
}

model ProgressNote {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitDate  DateTime
  summary    String
  agreements String?
  nextVisit  String?
  createdAt  DateTime @default(now())
}

model Appointment {
  id             String       @id @default(cuid())
  nutritionistId String
  nutritionist   Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  durationMin    Int          @default(45)
  reason         String?
  status         String       @default("programado")
  createdAt      DateTime     @default(now())

  @@index([nutritionistId, startsAt])
}

model Referral {
  id               String        @id @default(cuid())
  fullName         String
  dni              String?
  birthDate        String?
  phone            String?
  affiliateNumber  String?
  sex              String        @default("femenino")
  reason           String?
  status           String        @default("pendiente") // pendiente | asignado | presente | ausente | cancelado
  notes            String?
  scheduledAt      DateTime?
  durationMin      Int           @default(45)
  patientId        String?
  patient          Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  assignedToId     String?
  assignedTo       Nutritionist? @relation("ReferralAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedById     String
  assignedBy       Nutritionist  @relation("ReferralAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  appointmentId    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([scheduledAt])
  @@index([assignedToId, scheduledAt])
  @@index([status])
}

model Notification {
  id             String       @id @default(cuid())
  nutritionistId String
  nutritionist   Nutritionist @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  type           String
  title          String
  body           String
  href           String?
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([nutritionistId, read, createdAt])
}

model ActivityLog {
  id        String       @id @default(cuid())
  actorId   String
  actor     Nutritionist @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
