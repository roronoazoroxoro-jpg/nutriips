# Local (SQLite) — por defecto en desarrollo
DATABASE_URL="file:./dev.db"

# Producción (PostgreSQL en Neon / Vercel)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Obligatorio en producción (generá uno largo y aleatorio)
AUTH_SECRET=""

# Cookie segura en HTTPS (en Vercel se activa sola)
COOKIE_SECURE=false

# Usuario administrador inicial (solo si no existe)
INITIAL_EMAIL="nutricionista@nutriips.local"
INITIAL_PASSWORD="NutriIPS2026!"
INITIAL_NAME="Administración NutriIPS"

# Nombre del consultorio / departamento
CLINIC_NAME="Departamento de Nutrición · IPS"
