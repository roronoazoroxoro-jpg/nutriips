# ── Base de datos PostgreSQL (Neon) ─────────────────────────────
# En Neon: Connection details → copiá AMBAS:
#   DATABASE_URL = pooled (recomendado para Netlify / serverless)
#   DIRECT_URL   = direct   (para migraciones / prisma db push)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Seguridad ───────────────────────────────────────────────────
# Generá con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# true en HTTPS (Netlify). false en http://localhost
COOKIE_SECURE=false

# ── Usuario admin (solo si todavía no existe) ───────────────────
INITIAL_EMAIL="nutricionista@nutriips.local"
INITIAL_PASSWORD="NutriIPS2026!"
INITIAL_NAME="Administración NutriIPS"
CLINIC_NAME="Departamento de Nutrición · IPS"

# ── Correo (Brevo SMTP; From = Gmail del departamento) ──────────
# Cuenta Brevo: https://app.brevo.com/settings/keys/smtp
# Generá una SMTP key (pide verificación por SMS) y pegala en SMTP_PASS.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="c0fbcc001@smtp-brevo.com"
SMTP_PASS=""
MAIL_FROM="Departamento de Nutrición · IPS <ipsnutricionnutricion@gmail.com>"
MAIL_FROM_NAME="Departamento de Nutrición · IPS"
