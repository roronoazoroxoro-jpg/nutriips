{
  "name": "nutriips",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "prisma generate && next build",
    "start": "next start -p 3010",
    "setup": "prisma db push && node prisma/seed.mjs",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:staff": "node prisma/seed.mjs --reset-passwords",
    "db:export": "node scripts/export-all.mjs",
    "db:import": "node scripts/import-export.mjs",
    "backup": "node scripts/backup.mjs",
    "demo": "node scripts/demo.mjs",
    "video": "node scripts/video.mjs",
    "icons": "node scripts/make-icons.mjs",
    "cie10:import": "node scripts/import-cie10.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.484.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
